# Copie para .env e preencha. Nunca faça commit do .env.
# Porta do servidor.
PORTA=3000
# Arquivo do banco SQLite local.
TEB_BANCO=servidor/dados/teb.sqlite
# Pasta dos anexos cifrados. Nunca deixe dentro de uma pasta pública.
TEB_ANEXOS=servidor/dados/anexos
# Chave dos anexos, 32 bytes em base64. Obrigatória.
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TEB_CHAVE_ANEXOS=
# Banco Turso opcional. Com os dois preenchidos, o servidor usa o Turso no lugar do SQLite local.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Use 1 quando o site estiver atrás de HTTPS. Liga o atributo Secure do cookie.
TEB_HTTPS=0
# Use 1 só atrás de um proxy confiável. Liga a leitura de X-Forwarded-For.
TEB_CONFIAR_PROXY=0
# Endereço público usado no link de redefinição de senha.
TEB_URL_PUBLICA=http://localhost:3000
# Conta da plataforma. Criada pelo comando criar-plataforma ou garantir-plataforma.
# Com TEB_PLATAFORMA_SENHA no ambiente, a subida do servidor também cria a conta se faltar.
# Se a conta já existe, nada muda: só aparece um aviso. A senha da conta não muda pelo ambiente.
TEB_PLATAFORMA_DOCUMENTO=
TEB_PLATAFORMA_NOME=
TEB_PLATAFORMA_EMAIL=
# A senha NUNCA vai neste arquivo nem no Git. No Replit, coloque nos Secrets.
TEB_PLATAFORMA_SENHA=
# Recurso de TESTE, opcional, desligado por padrão (vazio).
# Com valor, por exemplo admin, esse usuário entra no lugar do CPF da plataforma (sem diferenciar maiúsculas).
# A senha é a da conta da plataforma (a dos Secrets). Limite de tentativas e auditoria continuam valendo.
# Apague a variável antes de usar o sistema de verdade.
# TEB_PLATAFORMA_LOGIN=admin
TEB_PLATAFORMA_LOGIN=

# ---------------------------------------------------------------
# Exemplo no servidor real. Recurso de TESTE, desligado por padrão (vazio).
# Cria a organização exemplo-teste com gestor, avaliador e proponente fictícios, editais, inscrições,
# notas, recurso e aviso, iguais às telas da demonstração. Os CPFs ficam no README da raiz.
# Com 1, a subida cria o exemplo se faltar (o disco do Replit publicado pode ser zerado a cada reinício).
# Se já existe, nada muda. O comando node servidor/principal.js semear-exemplo faz o mesmo.
# Apague as duas variáveis antes de usar o sistema de verdade.
TEB_SEMEAR_EXEMPLO=
# Senha das três contas do exemplo. 12 caracteres ou mais, nada comum.
# A senha NUNCA vai neste arquivo nem no Git. No Replit, coloque nos Secrets.
TEB_EXEMPLO_SENHA=

# ---------------------------------------------------------------
# Backups cifrados (AES-256-GCM). Guia completo em docs/backups.md.
# Chave do backup, 32 bytes em base64, DIFERENTE de TEB_CHAVE_ANEXOS.
# Guarde uma cópia fora do servidor (cofre de senhas). Sem ela, o backup não abre.
TEB_CHAVE_BACKUP=
# Quantos backups do banco manter em cada destino. Os anexos nunca são apagados.
TEB_BACKUP_RETER=14
# Pasta temporária usada durante o backup e a restauração.
TEB_BACKUP_TEMP=servidor/dados/tmp-backup
# Backup automático dentro do servidor, em horas. 0 desliga (use um agendador externo).
TEB_BACKUP_INTERVALO_HORAS=0
# Destino 1: Google Drive (conta grátis, 15 GB). OAuth com escopo drive.file.
TEB_GDRIVE_CLIENT_ID=
TEB_GDRIVE_CLIENT_SECRET=
TEB_GDRIVE_REFRESH_TOKEN=
TEB_GDRIVE_PASTA_ID=
# Destino 2: Backblaze B2. Chave de aplicação restrita a um bucket PRIVADO.
TEB_B2_KEY_ID=
TEB_B2_APP_KEY=
TEB_B2_BUCKET_ID=
TEB_B2_BUCKET_NOME=
# Destino 3: GitHub, repositório PRIVADO, só com o banco. Token fino com Contents: leitura e escrita.
# O sistema recusa enviar para repositório público.
TEB_GITHUB_TOKEN=
TEB_GITHUB_REPO=
TEB_GITHUB_RAMO=main
# O Git guarda no histórico todo backup apagado. Por isso o GitHub recebe o banco só a cada N dias.
TEB_GITHUB_INTERVALO_DIAS=7
# Restauração: banco e pasta NOVOS. A restauração nunca sobrescreve.
TEB_RESTAURAR_BANCO=servidor/dados/restaurado.sqlite
TEB_RESTAURAR_ANEXOS=servidor/dados/anexos-restaurados

# ---------------------------------------------------------------
# E-mail (link de redefinição de senha). Guia em docs/seguranca.md.
# Resend: chave da API e remetente de um domínio verificado. Sem isso, nenhum link é enviado nem vai para o log.
TEB_EMAIL_RESEND_CHAVE=
TEB_EMAIL_REMETENTE=
# Só em desenvolvimento: 1 mostra o link no terminal. Recusado com TEB_HTTPS=1.
TEB_EMAIL_LOG_LINK=0
